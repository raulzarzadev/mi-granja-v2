rules_version = '2';

// Contención de las reglas abiertas recuperadas de producción el 12/11/2026.
// Bloquea clientes sin sesión; NO implementa todavía aislamiento por granja.
// Mantener separado de las reglas permisivas del emulador.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{document=**} {
      allow read, write: if request.auth != null && collection != 'aiChatHistory';
    }
  }
}
