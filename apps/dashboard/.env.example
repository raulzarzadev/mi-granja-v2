# Public application origin used by Stripe redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI provider credentials (server-side only). The active model can be changed in /admin.
OPENROUTER_API_KEY=
# Optional fallback before an administrator saves a model in Firestore.
OPENROUTER_MODEL=google/gemini-2.5-flash

# Stripe server-side secrets (never expose with NEXT_PUBLIC_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Recurring Stripe Price IDs
STRIPE_PRICE_INICIAL=
STRIPE_PRICE_BASICO=
STRIPE_PRICE_PRO=
STRIPE_PRICE_RANCHO=
