---
import PostHogAnalytics from '../components/PostHogAnalytics.astro'
import { DASHBOARD_URL } from '../lib/urls'
import {
  DEFAULT_DESCRIPTION,
  PRODUCT_FEATURES,
  SITE_NAME,
  SITE_URL,
} from '../lib/product-content'

interface Props {
  title: string
  description: string
  canonicalURL?: string
  keywords?: string
  extraJsonLd?: Record<string, unknown> | Record<string, unknown>[]
}

const { title, description, canonicalURL, keywords, extraJsonLd } = Astro.props
// Force canonical host to www.migranja.app regardless of how the page was reached
const canonical = canonicalURL || new URL(Astro.url.pathname, SITE_URL).href
const ogImage = `${SITE_URL}/og-image.png`
const markdownURL = new URL(
  Astro.url.pathname === '/' ? '/index.md' : `${Astro.url.pathname.replace(/\/$/, '')}.md`,
  SITE_URL,
).href

const serializeJsonLd = (value: Record<string, unknown>) =>
  JSON.stringify(value).replace(/</g, '\\u003c')

const jsonLdSoftware = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${SITE_URL}/#software`,
  name: SITE_NAME,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: DEFAULT_DESCRIPTION,
  url: SITE_URL,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  featureList: PRODUCT_FEATURES,
  inLanguage: 'es-MX',
  publisher: { '@id': `${SITE_URL}/#organization` },
}

const jsonLdOrg = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: SITE_NAME,
  url: SITE_URL,
  logo: `${SITE_URL}/logo/logo-migranja.png`,
}

const jsonLdWebsite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: SITE_NAME,
  alternateName: 'MiGranja.app',
  url: SITE_URL,
  inLanguage: 'es-MX',
  publisher: { '@id': `${SITE_URL}/#organization` },
}

const extraJsonLdItems = Array.isArray(extraJsonLd)
  ? extraJsonLd
  : extraJsonLd
    ? [extraJsonLd]
    : []
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={markdownURL} />
    <link rel="describedby" href={`${SITE_URL}/llms.txt`} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="Mi Granja" />
    <meta name="theme-color" content="#16a34a" />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico?v=3" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mi Granja — Software ganadero en español" />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Mi Granja — Software ganadero en español" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={serializeJsonLd(jsonLdSoftware)} />
    <script type="application/ld+json" set:html={serializeJsonLd(jsonLdOrg)} />
    <script type="application/ld+json" set:html={serializeJsonLd(jsonLdWebsite)} />
    {extraJsonLdItems.map((item) => (
      <script type="application/ld+json" set:html={serializeJsonLd(item)} />
    ))}

    <!-- Preconnect -->
    <link rel="preconnect" href={DASHBOARD_URL} />

    <PostHogAnalytics />
  </head>
  <body class="bg-white text-gray-900">
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
