---
import { PLAN_TIERS } from '@mi-granja/shared'
import CTA from '../components/CTA.astro'
import FAQ from '../components/FAQ.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import Pricing from '../components/Pricing.astro'
import Layout from '../layouts/Layout.astro'

const pricingSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Mi Granja',
  description: 'Software ganadero con planes mensuales según la cantidad de animales activos.',
  brand: { '@type': 'Brand', name: 'Mi Granja' },
  offers: PLAN_TIERS.filter((tier) => tier.priceUsd !== null).map((tier) => ({
    '@type': 'Offer',
    name: `Plan ${tier.label}`,
    price: String(tier.priceUsd),
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  })),
}
---

<Layout
  title="Precios de Mi Granja | Planes desde $2.50 USD/mes"
  description="Planes de Mi Granja por cantidad de animales: gratis hasta 10 y opciones para inventarios de todos los tamaños."
  canonicalURL="https://www.migranja.app/prices"
  keywords="precios software ganadero, plan gratis ganadero, software ganadero con IA, Mi Granja precios"
  extraJsonLd={pricingSchema}
>
  <Header />
  <main>
    <section class="bg-gradient-to-br from-green-50 via-white to-white pb-10 pt-28 text-center sm:pt-36">
      <div class="mx-auto max-w-3xl px-4">
        <p class="inline-flex rounded-full bg-green-100 px-4 py-1.5 text-sm font-semibold text-green-800">Sin cargos por granja o colaborador</p>
        <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">Paga solo por la capacidad de tu inventario</h1>
        <p class="mt-6 text-lg leading-8 text-gray-600">Empieza gratis con hasta 10 animales y cambia de tier conforme crece tu operación.</p>
      </div>
    </section>
    <Pricing />
    <FAQ />
    <CTA />
  </main>
  <Footer />
</Layout>
