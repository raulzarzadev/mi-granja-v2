rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function farmOwner(farmId) {
      let farm = firestore.get(/databases/(default)/documents/farms/$(farmId)).data;
      return signedIn() && farm.ownerId == request.auth.uid;
    }
    function farmMember(farmId) {
      let farm = firestore.get(/databases/(default)/documents/farms/$(farmId)).data;
      return signedIn() && (farm.ownerId == request.auth.uid ||
        ('collaboratorsIds' in farm && request.auth.uid in farm.collaboratorsIds));
    }
    function animalFarm(animalId) {
      return firestore.get(/databases/(default)/documents/animals/$(animalId)).data.farmId;
    }
    function imageUpload() {
      return request.resource == null ||
        (request.resource.size <= 10 * 1024 * 1024 &&
         request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic|heif)'));
    }
    match /avatars/{userId}/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() && request.auth.uid == userId && imageUpload();
    }
    // New photos are immutable, unique assets in the uploader's own namespace.
    // The animal stores the download URL, including for photos uploaded before animal creation.
    match /users/{userId}/animal-photos/{file} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if resource == null && signedIn() && request.auth.uid == userId && imageUpload();
      allow delete: if signedIn() && request.auth.uid == userId;
      allow update: if false;
    }
    match /farms/{farmId}/logo/{allPaths=**} {
      allow read: if signedIn() && farmMember(farmId);
      allow write: if signedIn() && farmOwner(farmId) && imageUpload();
    }
    // Legacy photos: no writes across farms. New uploads use the namespace above.
    match /animals/{animalId}/photos/{file} {
      allow read: if signedIn() && farmMember(animalFarm(animalId));
      allow write: if signedIn() && farmOwner(animalFarm(animalId)) && imageUpload();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
