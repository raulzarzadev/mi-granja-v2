---
import { PLAN_TIERS } from '@mi-granja/shared'
import { DASHBOARD_AUTH_URL } from '../lib/urls'
---

<section id="precios" class="bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Precios por cantidad de animales</h2>
      <p class="mt-4 text-lg text-gray-600">
        Todas las funciones, granjas y colaboradores incluidos. Elige la capacidad que necesita tu inventario.
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-6xl gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {PLAN_TIERS.map((tier) => (
        <article class:list={['flex flex-col rounded-2xl border bg-white p-6 shadow-sm', tier.id === 'pro' ? 'border-green-600 ring-1 ring-green-600' : 'border-gray-200']}>
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-xl font-bold text-gray-900">{tier.label}</h3>
            {tier.id === 'pro' && <span class="rounded-full bg-green-600 px-2.5 py-1 text-xs font-semibold text-white">Popular</span>}
          </div>
          <p class="mt-5 text-3xl font-extrabold text-gray-900">
            {tier.priceUsd === null ? 'A convenir' : `$${tier.priceUsd.toLocaleString('en-US')} USD`}
          </p>
          <p class="mt-1 text-sm text-gray-500">{tier.priceUsd ? 'al mes' : 'para operaciones grandes'}</p>
          <p class="mt-5 flex-1 text-sm text-gray-700">{tier.description}</p>
          <ul class="mt-5 space-y-2 text-sm text-gray-600">
            <li>✓ Granjas y colaboradores incluidos</li>
            <li>✓ Gestión, reproducción y salud</li>
            <li>✓ Asistente IA y respaldos</li>
          </ul>
          <a
            href={tier.id === 'empresarial' ? 'mailto:hola@migranja.app?subject=Plan Empresarial Mi Granja' : DASHBOARD_AUTH_URL}
            class:list={['mt-6 block w-full rounded-xl px-5 py-3 text-center font-semibold transition-colors', tier.id === 'free' ? 'border-2 border-green-600 text-green-700 hover:bg-green-50' : 'bg-green-600 text-white hover:bg-green-700']}
            data-ph-event="cta_click"
            data-ph-location="pricing"
            data-ph-plan={tier.id}
          >
            {tier.id === 'empresarial' ? 'Contactar' : tier.id === 'free' ? 'Comenzar gratis' : 'Elegir plan'}
          </a>
        </article>
      ))}
    </div>

    <p class="mx-auto mt-8 max-w-3xl text-center text-sm text-gray-500">
      Solo cuentan animales activos; los marcados como vendidos o muertos no se incluyen en el cálculo.
    </p>
  </div>
</section>
